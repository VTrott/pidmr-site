---
const cards = [
    {
        href:"/about",
        image:"/public/images/teaching.jpeg",
        alt:"A teacher leading a class beside the chart",
        title: "Our classes",
        text: "How a class works, what we study and how to join in person or online.",
        action:"Learn more"
    },
    {
        href:"/lectures",
        image:"/public/images/teaching-2.jpeg",
        alt:"A teacher leading a class beside the chart",
        title: "Lecture library",
        text: "Every recorded lecture, newest first. Watch free, anytime.",
        action:"Watch now"
    },
    {
        href:"/gallery",
        image:"/public/images/Community.jpeg",
        alt:"Class member together on an outing by a river",
        title: "Our community",
        text: "Outings, events, and photos from our time together.",
        action:"See photos"
    },
    
];
---
<section class="learn">
    <div class="container">
        <p class="eyebrow"> Learn with us</p>
        <h2>Find your place in class</h2>

        <div class="cards">
            {cards.map((card)=> (
                <a href={card.href} class="card">
                    <img src={card.image} alt={card.alt} loading="lazy"/>
                    <div class="body">
                        <span class="title">{card.title}</span>
                        <span class="text">{card.text}</span>
                        <span class="action">{card.action}</span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>

<style>
    .learn {
        background: var(--cream);
        padding: 64px 0;
    }

    h2 {
        margin: 12px 0 24px;
        color: var(--navy);
        font-size: 32px;
        line-height: 1.15;
    }
    
    .cards{
        display: grid; 
        gap: 24px;
    }

    .card {
        display: flex;
        flex-direction: column;
        background: #FFFFFF;
        border-radius: 4px;
        overflow: hidden;
        text-decoration: none;
    }

    .card img {
        width: 100%;
        height: 220px;
        display: block;
        object-fit: cover;
        object-position: center 25%;
    }

    .body {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 22px;
        border-top: 4px solid var(--gold);
    }
    
    .title { 
        font-family: var(--serif);
        font-size: 24px; 
        color: var(--navy);
    }

    .text {
        font-size:15px;
        line-height:1.6; 
        color: #3A4252;
    }

    .action{
        margin-top: 6px;
        color:var(--navy);
        font-size:14px;
        font-weight:700; 
        letter-spacing: 0.5px;
        text-transform:uppercase;
    }
    .card:hover .action {
        text-decoration:underline;
    }

    @media (min-width:768px){
        .learn {
            padding:112px 0;
        }
        h2 {
            font-size:44px;
            margin-bottom: 48px;
        }
        .cards {
            grid-template-columns: repeat(3,1fr);
            gap: 32px;
        }
        .card img {
            height: 280px;
        }
        .body {
            padding:28px; 
            gap: 10px;
        }
        .title {
            font-size:26px;
        }
        .text { 
            font-size:16px;
        }
    }
</style>