const year = new Date().getFullYear();
---

<footer class="site-footer">
    <span class="name">PIDMR</span>
    <div class="details">
        <a href="mailto:pasadenaidmr@gmail.com">pasadenaidmr@gmail.com</a>
        <a href="tel:+13862432856">386-243-2856</a>
        <a href="https://www.facebook.com/pidmr.org">Facebook</a>
        <a href="https://www.youtube.com/@pasadenainstituteofdivinem5316">Youtube</a>
        <span>© {year}</span>
